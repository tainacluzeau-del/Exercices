      { key: "porc_carottes", title: "Porc poêlé aux carottes", required: ["ing-11", "ing-16", "ing-22", "ing-20"], image: "https://images.unsplash.com/photo-1514944288352-fffac99f0bdf?auto=format&fit=crop&w=800&q=80" },
      { key: "pates_champignons", title: "Pâtes au fromage et champignons", required: ["ing-9", "ing-14", "ing-13", "ing-20"], image: "https://images.unsplash.com/photo-1551183053-bf91a1d81141?auto=format&fit=crop&w=800&q=80" },
      { key: "milkshake", title: "Milk-shake fraise-banane", required: ["ing-2", "ing-17", "ing-18", "ing-5"], image: "https://images.unsplash.com/photo-1553530666-ba11a7da3888?auto=format&fit=crop&w=800&q=80" },
      { key: "tartine_miel", title: "Tartine sucrée au miel et fraises", required: ["ing-8", "ing-4", "ing-21", "ing-17"], image: "https://images.unsplash.com/photo-1484723091739-30a097e8f929?auto=format&fit=crop&w=800&q=80" },
      { key: "beignets_banane", title: "Beignets aux bananes", required: ["ing-1", "ing-18", "ing-3", "ing-5"], image: "https://images.unsplash.com/photo-1621236378699-8597faf6a176?auto=format&fit=crop&w=800&q=80" },
      { key: "chocolat_chaud", title: "Chocolat chaud gourmand", required: ["ing-2", "ing-6", "ing-5", "ing-4"], image: "https://images.unsplash.com/photo-1542990253-0d0f5be5f0ed?auto=format&fit=crop&w=800&q=80" }
    ];

    let selectedItem = null;

    const viewSelect = document.getElementById('view-select');
    const viewSimon = document.getElementById('view-simon');
    const viewEmilie = document.getElementById('view-emilie');

    function resetCauldronsToFridge() {
      const fridge = document.getElementById('fridge');
      const itemsInCauldrons = document.querySelectorAll('.dropzone .item');
      itemsInCauldrons.forEach(item => {
        item.classList.remove('selected-item');
        fridge.appendChild(item);
      });
      selectedItem = null;
      updateAllCauldrons();
    }

    viewSelect.addEventListener('change', (e) => {
      resetCauldronsToFridge();
      if (e.target.value === 'simon') {
        viewSimon.classList.remove('hidden');
        viewEmilie.classList.add('hidden');
      } else {
        viewSimon.classList.add('hidden');
        viewEmilie.classList.remove('hidden');
      }
    });

    const items = document.querySelectorAll('.item');
    items.forEach(item => {
      item.addEventListener('click', (e) => {
        e.stopPropagation();
        if (item.parentElement.id !== 'fridge') {
          document.getElementById('fridge').appendChild(item);
          item.classList.remove('selected-item');
          selectedItem = null;
          updateAllCauldrons();
          return;
        }

        items.forEach(i => i.classList.remove('selected-item'));
        if (selectedItem === item) {
          selectedItem = null;
        } else {
          selectedItem = item;
          item.classList.add('selected-item');
        }
      });
    });

    const dropzones = document.querySelectorAll('.dropzone');
    dropzones.forEach(zone => {
      zone.addEventListener('click', () => {
        if (selectedItem) {
          zone.appendChild(selectedItem);
          selectedItem.classList.remove('selected-item');
          selectedItem = null;
          updateAllCauldrons();
        }
      });
    });

    function updateAllCauldrons() {
      updateCauldronState('simon');
      updateCauldronState('emilie');
    }

    function updateCauldronState(key) {
      const container = document.getElementById(`cauldron-${key}`);
      const summary = document.getElementById(`summary-${key}`);
      const currentItems = Array.from(container.querySelectorAll('.item'));
      const currentIds = currentItems.map(el => el.getAttribute('data-id'));

      summary.innerHTML = '';
      if (currentItems.length === 0) {
        summary.innerHTML = '<li class="text-slate-400 italic list-none">Le chaudron est vide.</li>';
      } else {
        currentIds.forEach(id => {
          const data = ingredientsData[id];
          if (data) {
            const li = document.createElement('li');
            li.textContent = data.name;
            summary.appendChild(li);
          }
        });
      }

      if (key === 'emilie') {
        const status = document.getElementById('status-emilie');
        const btnEx = document.getElementById('generate-exercise-btn');
        if (currentIds.length === 0) {
          status.className = "mt-3 p-3 rounded-xl text-center font-bold text-sm bg-slate-100 text-slate-600 border border-slate-200";
          status.textContent = "Le chaudron est vide.";
          btnEx.classList.add('hidden');
        } else if (currentIds.length >= 4) {
          status.className = "mt-3 p-3 rounded-xl text-center font-bold text-sm bg-emerald-100 text-emerald-800 border border-emerald-300";
          status.textContent = "Prêt à cuisiner et à générer l'exercice !";
          btnEx.classList.remove('hidden');
        } else {
          status.className = "mt-3 p-3 rounded-xl text-center font-bold text-sm bg-amber-100 text-amber-800 border border-amber-300";
          status.textContent = `Encore ${4 - currentIds.length} ingrédient(s) pour générer l'exercice !`;
          btnEx.classList.add('hidden');
        }
      }
    }

    const recipeSelect = document.getElementById('recipe-select');
    const simonInstruction = document.getElementById('simon-instruction');

    function updateSimonInstruction() {
      const selectedKey = recipeSelect.value;
      const recipe = recipesSimon[selectedKey];
      simonInstruction.textContent = recipe.instruction;
      document.getElementById('result-simon').classList.add('hidden');
    }

    recipeSelect.addEventListener('change', () => {
      resetCauldronsToFridge();
      updateSimonInstruction();
    });
    updateSimonInstruction();

    document.getElementById('cook-simon-btn').addEventListener('click', () => {
      const recipeKey = recipeSelect.value;
      const recipe = recipesSimon[recipeKey];
      const container = document.getElementById('cauldron-simon');
      const currentIds = Array.from(container.querySelectorAll('.item')).map(el => el.getAttribute('data-id'));
      const resultDiv = document.getElementById('result-simon');

      const isExact = recipe.required.length === currentIds.length && 
                      recipe.required.every(id => currentIds.includes(id));

      resultDiv.classList.remove('hidden');

      if (isExact) {
        resultDiv.className = "mt-4 p-4 rounded-xl border bg-emerald-50 border-emerald-300 text-center space-y-3";
        resultDiv.innerHTML = `
          <div class="font-extrabold text-emerald-900 text-lg">🎉 Bravo ! Recette réussie !</div>
          <img src="${recipe.image}" alt="${recipe.title}" class="w-full h-48 object-cover rounded-xl shadow-md border border-emerald-200">
        `;
        resetCauldronsToFridge();
      } else {
        const missingIds = recipe.required.filter(id => !currentIds.includes(id));
        const missingNames = missingIds.map(id => ingredientsData[id].partitive + " " + ingredientsData[id].name).join(', ');

        resultDiv.className = "mt-4 p-4 rounded-xl border bg-rose-50 border-rose-300 space-y-3";
        resultDiv.innerHTML = `
          <div class="font-bold text-rose-900 text-center">Pouah ! C'est une bouillie indigeste !</div>
          <p class="text-xs text-rose-800 text-center">Pour réussir la recette du Chef Simon, il fallait ajouter : <span class="font-bold">${missingNames}</span>.</p>
        `;
      }
    });

    const generateExerciseBtn = document.getElementById('generate-exercise-btn');
    const exerciseSection = document.getElementById('exercise-section');
    const exerciseQuestions = document.getElementById('exercise-questions');
    const checkExerciseBtn = document.getElementById('check-exercise-btn');
    const exerciseScore = document.getElementById('exercise-score');
    const grammarModeSelect = document.getElementById('grammar-mode-select');

    function shuffleArray(array) {
      const shuffled = [...array];
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      return shuffled;
    }

    generateExerciseBtn.addEventListener('click', () => {
      const container = document.getElementById('cauldron-emilie');
      const currentIds = Array.from(container.querySelectorAll('.item')).map(el => el.getAttribute('data-id'));
      const resultDiv = document.getElementById('result-emilie');

      if (currentIds.length < 4) return;

      let matchedRecipe = null;
      for (let r of knownRecipesFree) {
        const hasAll = r.required.every(id => currentIds.includes(id));
        const noExtra = currentIds.every(id => r.required.includes(id));
        if (hasAll && noExtra) {
          matchedRecipe = r;
          break;
        }
      }

      resultDiv.classList.remove('hidden');
      if (matchedRecipe) {
        resultDiv.className = "mt-4 p-4 rounded-xl border bg-emerald-50 border-emerald-300 text-center space-y-3";
        resultDiv.innerHTML = `
          <div class="font-extrabold text-emerald-900 text-lg">🎉 Bravo ! Tu as préparé : ${matchedRecipe.title} !</div>
          <img src="${matchedRecipe.image}" alt="${matchedRecipe.title}" class="w-full h-48 object-cover rounded-xl shadow-md border border-emerald-200">
        `;
        resetCauldronsToFridge();
      } else {
        resultDiv.className = "mt-4 p-4 rounded-xl border bg-rose-50 border-rose-300 text-center space-y-2";
        resultDiv.innerHTML = `
          <div class="font-bold text-rose-900">Pouah ! Qu'est-ce que c'est que cette recette ?</div>
          <p class="text-xs text-rose-700">Ces ingrédients ne forment aucune recette connue de la Cheffe Émilie !</p>
        `;
      }

      exerciseQuestions.innerHTML = '';
      exerciseScore.textContent = '';
      const mode = grammarModeSelect.value;
      const shuffledIds = shuffleArray(currentIds);

      shuffledIds.forEach((id, index) => {
        const data = ingredientsData[id];
        if (!data) return;

        let expectedAnswer = "";
        let promptText = "";

        if (mode === 'partitifs') {
          expectedAnswer = data.partitive;
          promptText = `Dans mon chaudron, je mets <span class="font-bold border-b-2 border-slate-400 px-2 text-blue-700">______</span> ${data.name}.`;
        } else {
          if (data.type === 'v') {
            expectedAnswer = "d'";
            promptText = `Je verse une cuillère <span class="font-bold border-b-2 border-slate-400 px-2 text-blue-700">______</span> ${data.name}.`;
          } else if (data.quant === "") {
            expectedAnswer = "trois";
            promptText = `J'ajoute <span class="font-bold border-b-2 border-slate-400 px-2 text-blue-700">______</span> ${data.name}. (ex: trois)`;
          } else {
            expectedAnswer = "de";
            promptText = `Je mets un peu <span class="font-bold border-b-2 border-slate-400 px-2 text-blue-700">______</span> ${data.name}.`;
          }
        }

        const qDiv = document.createElement('div');
        qDiv.className = "p-3.5 bg-white border border-amber-200 rounded-xl flex flex-col sm:flex-row sm:items-center gap-3 text-sm";
        qDiv.innerHTML = `
          <span class="font-bold text-amber-800 w-6">${index + 1}.</span>
          <span class="text-slate-800 flex-1">${promptText}</span>
          <input type="text" data-expected="${expectedAnswer}" class="ex-input border border-slate-300 rounded-lg px-3 py-1.5 font-medium focus:ring-2 focus:ring-amber-500 focus:outline-none w-full sm:w-36" placeholder="Réponse...">
          <span class="feedback text-xs font-bold px-2 py-1 rounded hidden"></span>
        `;
        exerciseQuestions.appendChild(qDiv);
      });

      exerciseSection.classList.remove('hidden');
      exerciseSection.scrollIntoView({ behavior: 'smooth' });
    });

    checkExerciseBtn.addEventListener('click', () => {
      const inputs = exerciseQuestions.querySelectorAll('.ex-input');
      let correctCount = 0;

      inputs.forEach(input => {
        const expected = input.getAttribute('data-expected').toLowerCase().trim();
        const user = input.value.trim().toLowerCase();
        const feedback = input.nextElementSibling;

        if (user === expected) {
          correctCount++;
          input.className = "ex-input border-2 border-emerald-500 bg-emerald-50 rounded-lg px-3 py-1.5 font-bold text-emerald-900 w-full sm:w-36";
          feedback.textContent = "Bravo !";
          feedback.className = "feedback text-xs font-bold px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 block";
        } else {
          input.className = "ex-input border-2 border-rose-500 bg-rose-50 rounded-lg px-3 py-1.5 font-bold text-rose-900 w-full sm:w-36";
          feedback.textContent = `Réponse : ${expected}`;
          feedback.className = "feedback text-xs font-bold px-2.5 py-1 rounded-lg bg-rose-100 text-rose-800 block";
        }
      });

      exerciseScore.textContent = `Score : ${correctCount} / ${inputs.length}`;
      if (correctCount === inputs.length) {
        exerciseScore.className = "font-bold text-sm text-emerald-700";
      } else {
        exerciseScore.className = "font-bold text-sm text-amber-700";
      }
    });

    const dictModal = document.getElementById('dict-modal');
    const openDictBtn = document.getElementById('open-dict-btn');
    const closeDictBtn = document.getElementById('close-dict-btn');
    const dictContent = document.getElementById('dict-content');

    openDictBtn.addEventListener('click', () => {
      dictContent.innerHTML = '';
      Object.keys(ingredientsData).forEach(id => {
        const item = ingredientsData[id];
        const card = document.createElement('div');
        card.className = "p-3 bg-slate-50 border rounded-xl flex items-center gap-3";
        card.innerHTML = `
          <span class="text-2xl">${item.emoji}</span>
          <div>
            <div class="font-bold text-slate-800 capitalize">${item.name}</div>
            <div class="text-xs text-slate-500">Exemple : <span class="font-semibold text-amber-800">${item.partitive} ${item.name}</span></div>
          </div>
        `;
        dictContent.appendChild(card);
      });
      dictModal.classList.remove('hidden');
    });

    closeDictBtn.addEventListener('click', () => {
      dictModal.classList.add('hidden');
    });

    dictModal.addEventListener('click', (e) => {
      if (e.target === dictModal) dictModal.classList.add('hidden');
    });

    updateAllCauldrons();
  </script>
</body>
</html>
